{
  "multipart": [
    {
      "when": { "facing": "up" },
      "apply": { "model": "create_alarm:block/alarm", "x": -180}
    },
    {
      "when": { "facing": "down" },
      "apply": { "model": "create_alarm:block/alarm"}
    },
    {
      "when": { "facing": "north" },
      "apply": { "model": "create_alarm:block/alarm", "x": -90, "y": 0 }
    },
    {
      "when": { "facing": "south" },
      "apply": { "model": "create_alarm:block/alarm", "x": -90, "y": -180 }
    },
    {
      "when": { "facing": "west" },
      "apply": { "model": "create_alarm:block/alarm", "x": -90, "y": -90 }
    },
    {
      "when": { "facing": "east" },
      "apply": { "model": "create_alarm:block/alarm", "x": 90, "y": -90}
    }
  ]
}